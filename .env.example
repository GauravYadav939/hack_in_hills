# Environment Configuration for Glasshouse Broker
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to version control

# === Broker Configuration ===
BROKER_HOST=0.0.0.0
BROKER_PORT=8000
ENVIRONMENT=development

# === Ollama Configuration ===
# Use 'ollama' for Docker networking, 'localhost' for local development
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=30

# === Security Configuration ===
# Generate these with: python scripts/generate_keys.py
# These are base64-encoded NaCl keys
TOKEN_SIGNING_KEY=REPLACE_WITH_GENERATED_KEY
AUDIT_SIGNING_KEY=REPLACE_WITH_GENERATED_KEY

# Token expiration in seconds (default: 5 minutes)
TOKEN_EXPIRATION_SECONDS=300

# === Audit Log Configuration ===
AUDIT_DB_PATH=./data/audit.db

# === Timing Normalization ===
# Enable response time padding (true/false)
TIMING_NORMALIZATION_ENABLED=true
# Fixed response time in seconds (0 = disabled)
TIMING_NORMALIZATION_TARGET=2.0

# === Policy Configuration ===
POLICY_FILE_PATH=./config/policy.json

# === Logging ===
LOG_LEVEL=INFO
